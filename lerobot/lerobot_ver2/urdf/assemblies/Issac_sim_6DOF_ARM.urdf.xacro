<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="Issac_sim_6DOF_ARM_macro">

  <xacro:macro name="Issac_sim_6DOF_ARM" params="prefix">

    <!-- Links -->
    <link name="${prefix}base_link">
      <inertial>
        <origin xyz="0.093970 -0.012453 0.026886" rpy="0 0 0"/>
        <mass value="0.124630"/>
        <inertia ixx="1.100219e-04" ixy="-1.277713e-08" ixz="-1.416650e-09"
                 iyy="1.435595e-04" iyz="-1.458301e-06" izz="1.335628e-04"/>
      </inertial>
      <visual>
        <origin xyz="0.000000 0.000000 0.000000" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://lerobot_ver2/meshes/Issac_sim_6DOF_ARM/base_link.dae" scale="1 1 1"/>
        </geometry>
        <material name="PLA_base_link_67_43g"/>
      </visual>
      <collision>
        <origin xyz="0.000000 0.000000 0.000000" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://lerobot_ver2/meshes/Issac_sim_6DOF_ARM/base_link_collision.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>

    <xacro:if value="$(arg with_gripper)">
    <link name="${prefix}gripper">
      <inertial>
        <origin xyz="0.024154 0.003437 -0.022247" rpy="0 0 0"/>
        <mass value="0.013810"/>
        <inertia ixx="4.486468e-06" ixy="-1.025877e-06" ixz="-2.593753e-10"
                 iyy="7.790068e-06" iyz="8.090210e-13" izz="4.934932e-06"/>
      </inertial>
      <visual>
        <origin xyz="-0.000000 -0.000000 -0.041500" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://lerobot_ver2/meshes/Issac_sim_6DOF_ARM/gripper.dae" scale="1 1 1"/>
        </geometry>
        <material name="PLA_part_13_81g"/>
      </visual>
      <collision>
        <origin xyz="-0.000000 -0.000000 -0.041500" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://lerobot_ver2/meshes/Issac_sim_6DOF_ARM/gripper_collision.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>
    </xacro:if>

  </xacro:macro>

</robot>