<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="Issac_sim_6DOF_ARM">

  <!-- Tunable gripper-joint origin (J5 -> gripper). Override on the launch command line to
       position/orient the jaw relative to the gripper motor, e.g.:
         ros2 launch ... display.launch.py gz:=0.02 gY:=0 gP:=1.5708
       Defaults reproduce the original exported values. -->
  <!-- Calibrated gripper-joint origin: the exported model had the jaw mounted ~2.8cm off
       (x -0.02, y +0.02); these defaults place it correctly. Still overridable on the CLI. -->
  <xacro:arg name="gx" default="-0.020000"/>
  <xacro:arg name="gy" default="0.020000"/>
  <xacro:arg name="gz" default="0.022210"/>
  <xacro:arg name="gR" default="0.0"/>
  <xacro:arg name="gP" default="0.0"/>
  <xacro:arg name="gY" default="-3.141593"/>

  <!-- Drop the gripper link+joint (with_gripper:=false) for the keyboard tuning tool,
       which overlays its own movable gripper marker instead. -->
  <xacro:arg name="with_gripper" default="true"/>

  <!-- Materials (shared across all assemblies) -->
  <material name="PLA_base_link_67_43g">
    <color rgba="0.286 0.286 0.286 1.0"/>
  </material>
  <material name="XL430_ABS_57_2g">
    <color rgba="0.200 0.188 0.188 1.0"/>
  </material>
  <material name="PLA_part_13_81g">
    <color rgba="0.286 0.286 0.286 1.0"/>
  </material>

  <!-- Assembly includes -->
  <xacro:include filename="$(find lerobot_ver2)/urdf/assemblies/XL_430.urdf.xacro"/>
  <xacro:include filename="$(find lerobot_ver2)/urdf/assemblies/Issac_sim_6DOF_ARM.urdf.xacro"/>

  <!-- Instantiate assemblies -->
  <xacro:XL_430 prefix=""/>
  <xacro:Issac_sim_6DOF_ARM prefix=""/>

  <!-- Mount joints (cross-assembly connections) -->
  <!-- These define how assemblies connect to each other. -->
  <!-- When swapping a dummy assembly with a real part, -->
  <!-- update the include + macro call above, and adjust -->
  <!-- parent/child link names in the mount joint below. -->

  <joint name="base" type="revolute">
    <parent link="base_link"/>
    <child link="J1"/>
    <origin xyz="0.093965 0.007519 0.063900" rpy="1.570796 0.000000 1.570796"/>
    <axis xyz="-0.000000 1.000000 0.000000"/>
    <limit lower="1.570796" upper="4.712389" effort="100.0" velocity="1.00"/>
  </joint>

  <xacro:if value="$(arg with_gripper)">
    <joint name="gripper" type="revolute">
      <parent link="J5"/>
      <child link="gripper"/>
      <origin xyz="$(arg gx) $(arg gy) $(arg gz)" rpy="$(arg gR) $(arg gP) $(arg gY)"/>
      <axis xyz="0.000000 0.000000 1.000000"/>
      <limit lower="-1.570796" upper="0.087266" effort="100.0" velocity="1.00"/>
    </joint>
  </xacro:if>

  <!-- ROS 2 control: generated generic system -->
  <ros2_control name="Issac_sim_6DOF_ARM_system" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
      <param name="cmd_topic">sim/Issac_sim_6DOF_ARM_system/cmd</param>
      <param name="state_topic">sim/Issac_sim_6DOF_ARM_system/state</param>
    </hardware>

    <joint name="base">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="gripper">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>

</robot>